# Salin menjadi .env.production di VPS. Jangan commit file hasil salinan.
POSTGRES_USER=kapsflow
POSTGRES_PASSWORD=GANTI_DENGAN_PASSWORD_DATABASE_YANG_KUAT
POSTGRES_DB=kapsflow

# Akun migrasi (superuser), hanya dipakai container migrate. Password URL-encode
# harus sama dengan POSTGRES_PASSWORD.
DATABASE_URL=postgres://kapsflow:GANTI_PASSWORD_URL_ENCODED@db:5432/kapsflow?sslmode=disable

# Migrator mengatur password role ini tiap deploy. Password pada URL harus URL-encode
# dan cocok dengan APP_DATABASE_PASSWORD.
APP_DATABASE_PASSWORD=GANTI_DENGAN_PASSWORD_RUNTIME
APP_DATABASE_URL=postgres://kapsflow_app:GANTI_PASSWORD_RUNTIME_URL_ENCODED@db:5432/kapsflow?sslmode=disable

APP_DOMAIN=app.example.com
WEBSITE_DOMAIN=example.com
APP_BASE_URL=https://app.example.com
PUBLIC_BASE_URL=https://app.example.com
ENCRYPTION_KEY=GANTI_DENGAN_KUNCI_ENKRIPSI_32_BYTE
RESEND_API_KEY=
EMAIL_FROM=Trimwait Auth <auth@GANTI_DOMAIN_EMAIL>
VAPID_PUBLIC_KEY=GANTI_DENGAN_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=GANTI_DENGAN_VAPID_PRIVATE_KEY
VAPID_SUBJECT=mailto:admin@GANTI_DOMAIN
SENTRY_DSN=
