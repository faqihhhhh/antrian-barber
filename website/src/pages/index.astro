---
const appUrl = import.meta.env.PUBLIC_APP_URL || 'http://localhost:5173'
const siteUrl = import.meta.env.PUBLIC_SITE_URL || Astro.url.origin
const pageUrl = new URL(Astro.url.pathname, siteUrl).href
const socialImage = new URL('/icons/icon-512.png', siteUrl).href
const features = [
  {
    number: '01',
    title: 'Pelanggan pesan sendiri',
    description: 'Bagikan tautan outlet atau QR agar pelanggan bisa memilih tanggal, memesan antrian, dan membayar DP.',
  },
  {
    number: '02',
    title: 'Tim tahu siapa berikutnya',
    description: 'Admin mengelola antrian dan pembayaran DP. Kapster memanggil pelanggan serta memperbarui status layanan.',
  },
  {
    number: '03',
    title: 'Pemilik melihat usaha',
    description: 'Owner mengatur outlet dan staf, memantau statistik, serta melihat ulasan pelanggan.',
  },
]
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fafafa" />
    <meta name="description" content="Kapsflow membantu barbershop dan salon mengelola antrian pelanggan secara online." />
    <link rel="icon" href="/icons/icon.svg" type="image/svg+xml" />
    <meta property="og:title" content="Kapsflow — Antrian salon lebih tertata" />
    <meta property="og:description" content="Kapsflow membantu barbershop dan salon mengelola antrian pelanggan secara online." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>Kapsflow — Antrian salon lebih tertata</title>
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href="#beranda" aria-label="Kapsflow, ke beranda"><svg aria-hidden="true" viewBox="0 0 32 32" class="brand-glyph" fill="none"><circle cx="7" cy="8" r="4" stroke="currentColor" stroke-width="2.5" /><circle cx="7" cy="24" r="4" stroke="currentColor" stroke-width="2.5" /><path d="m10.5 10.5 16 15M10.5 21.5l16-15M14 16h13" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" /></svg>Kapsflow</a>
      <nav aria-label="Navigasi utama">
        <a href="#cara-kerja">Cara kerja</a>
        <a class="nav-login" href={`${appUrl}/masuk`}>Masuk</a>
        <a class="button button-small" href={`${appUrl}/daftar`}>Buat akun</a>
      </nav>
    </header>

    <main id="beranda">
      <section class="hero">
        <div class="hero-copy">
          <p class="eyebrow"><span></span> UNTUK BARBERSHOP &amp; SALON</p>
          <h1>Antrian rapi.<br /><em>Pelanggan nyaman.</em></h1>
          <p class="hero-description">Bantu pelanggan memesan dari ponsel, dan bantu tim mengelola layanan tanpa kehilangan urutan.</p>
          <div class="hero-actions">
            <a class="button" href={`${appUrl}/daftar`}>Buat akun <span aria-hidden="true">↗</span></a>
            <a class="text-link" href="#cara-kerja">Lihat cara kerja <span aria-hidden="true">↓</span></a>
          </div>
          <p class="hero-note">Untuk pemilik usaha, admin, kapster, dan pelanggan.</p>
        </div>

        <div class="preview-wrap">
          <div class="preview-glow"></div>
          <div class="app-window">
            <div class="window-bar" aria-hidden="true">
              <span class="window-dots"><i></i><i></i><i></i></span>
              <span class="window-address">Kapsflow · aplikasi</span>
              <span class="window-lock">●</span>
            </div>
            <iframe
              src={`${appUrl}/pelanggan/masuk`}
              title="Pratinjau aplikasi Kapsflow"
              loading="lazy"
              referrerpolicy="strict-origin-when-cross-origin"
            ></iframe>
          </div>
          <div class="floating-note"><span class="check">↗</span><span><b>Tampilan aplikasi asli</b><small>Pratinjau langsung dari Kapsflow</small></span></div>
        </div>
      </section>

      <section class="trust-strip" aria-label="Manfaat Kapsflow">
        <p>Lebih teratur dari awal sampai selesai</p>
        <div><span>01</span> Pesan online</div><div><span>02</span> Pantau giliran</div><div><span>03</span> Kelola dari satu layar</div>
      </section>

      <section id="cara-kerja" class="features workflow">
        <div class="section-heading"><p class="eyebrow">LANGKAH PEMESANAN</p><h2>Dari scan sampai<br />dipanggil.</h2></div>
        <ol class="step-list">
          <li><span class="step-number" data-step-number>01</span><p>Pelanggan scan QR atau buka tautan outlet</p></li>
          <li><span class="step-number" data-step-number>02</span><p>Pelanggan pilih tanggal dan bayar DP lewat QRIS</p></li>
          <li><span class="step-number" data-step-number>03</span><p>Tim memanggil pelanggan sesuai urutan</p></li>
        </ol>
      </section>

      <section class="features role-features">
        <div class="section-heading"><p class="eyebrow">FITUR SESUAI PERAN</p><h2>Untuk pemilik,<br />admin, dan kapster.</h2></div>
        <div class="feature-list">
          {features.map((feature) => (
            <article class="feature-item">
              <span class="feature-number">{feature.number}</span>
              <div><h3>{feature.title}</h3><p>{feature.description}</p></div>
              <span class="feature-arrow" aria-hidden="true">↗</span>
            </article>
          ))}
        </div>
      </section>

      <section class="proof-section" aria-labelledby="proof-title">
        <div class="section-heading"><p class="eyebrow">INFORMASI PRODUK</p><h2 id="proof-title">Bukti dan harga</h2></div>
        <div class="proof-grid">
          <article class="proof-card"><h3>Paket</h3><!-- TODO pemilik: isi nama dan cakupan paket yang benar --><p>[PAKET: isi oleh pemilik]</p></article>
          <article class="proof-card"><h3>Harga</h3><!-- TODO pemilik: isi harga paket yang sudah diputuskan --><p>[HARGA: isi oleh pemilik]</p></article>
          <article class="proof-card"><h3>Testimoni</h3><!-- TODO pemilik: isi testimoni asli dengan izin pelanggan --><p>[TESTIMONI: isi oleh pemilik]</p></article>
        </div>
      </section>

      <section class="demo-section" aria-labelledby="demo-title">
        <div><p class="eyebrow">LIHAT LANGSUNG</p><h2 id="demo-title">Minta demo</h2><p>Lihat alur Kapsflow sebelum memilih.</p></div>
        <!-- TODO pemilik: isi email kontak untuk permintaan demo --><a class="button" href="mailto:[EMAIL: isi oleh pemilik]">Minta demo <span aria-hidden="true">↗</span></a>
      </section>

      <section class="closing-cta">
        <div><p class="eyebrow">MULAI DARI OUTLET PERTAMAMU</p><h2>Beri waktu lebih banyak<br />untuk pelangganmu.</h2></div>
        <a class="button button-light" href={`${appUrl}/daftar`}>Buat akun <span aria-hidden="true">↗</span></a>
      </section>
    </main>

    <footer><a class="brand" href="#beranda" aria-label="Kapsflow, ke beranda"><svg aria-hidden="true" viewBox="0 0 32 32" class="brand-glyph" fill="none"><circle cx="7" cy="8" r="4" stroke="currentColor" stroke-width="2.5" /><circle cx="7" cy="24" r="4" stroke="currentColor" stroke-width="2.5" /><path d="m10.5 10.5 16 15M10.5 21.5l16-15M14 16h13" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" /></svg>Kapsflow</a><p>Antrian lebih tertata, layanan lebih nyaman.</p><nav aria-label="Informasi hukum"><a href="/syarat">Syarat penggunaan</a><a href="/privasi">Privasi</a></nav><span>© {new Date().getFullYear()} Kapsflow</span></footer>
  </body>
</html>

<style>
  :global(:root) { --color-ink: #171717; --color-ink-hover: #303030; --color-ink-muted: #525252; --color-paper: #fafafa; --color-paper-raised: #f4f4f5; --color-paper-muted: #e4e4e7; --color-line: #e4e4e7; --color-line-soft: #f0f0f1; --color-line-strong: #c4c4c7; --color-muted: #66666b; --color-body-muted: #525257; --color-body: #3f3f46; --color-brand: #404040; --color-brand-ink: #262626; }
  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-behavior: smooth; }
  :global(body) { margin: 0; background: var(--color-paper); color: var(--color-ink); font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
  :global(a) { color: inherit; text-decoration: none; }
  :global(:where(a, button, input, select, textarea, [tabindex]):focus-visible) { outline: 2px solid var(--color-ink); outline-offset: 2px; }
  .topbar { height: 82px; max-width: 1240px; margin: auto; padding: 0 40px; display: flex; align-items: center; justify-content: space-between; }
  .brand { display: inline-flex; align-items: center; gap: 10px; font-size: 20px; font-weight: 800; letter-spacing: -.7px; }
  .brand-glyph { width: 32px; height: 32px; flex: none; color: var(--color-ink); }
  nav { display: flex; align-items: center; gap: 30px; font-size: 13px; font-weight: 600; }
  nav a:not(.button) { color: var(--color-body-muted); }
  .button { display: inline-flex; align-items: center; justify-content: center; gap: 16px; min-height: 52px; padding: 0 22px; border-radius: 12px; background: var(--color-ink); color: var(--color-paper); font-size: 14px; font-weight: 700; transition: transform .2s, background .2s; }
  .button:hover { transform: translateY(-2px); background: var(--color-ink-hover); }
  .button-small { min-height: 42px; padding: 0 16px; }
  .hero { display: grid; grid-template-columns: 1.02fr .98fr; align-items: center; gap: 40px; max-width: 1240px; min-height: 720px; margin: auto; padding: 64px 40px 74px; }
  .hero-copy { position: relative; z-index: 1; }
  .eyebrow { margin: 0 0 22px; color: var(--color-muted); font-size: 12px; font-weight: 800; letter-spacing: 1.7px; }
  .hero .eyebrow { display: flex; align-items: center; gap: 9px; }
  .hero .eyebrow span, .live-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--color-ink-muted); }
  h1 { margin: 0; font-size: clamp(48px, 6vw, 76px); line-height: .99; letter-spacing: -1.5px; font-weight: 750; }
  h1 em { color: var(--color-ink-muted); font-style: normal; }
  .hero-description { max-width: 465px; margin: 26px 0 28px; color: var(--color-body-muted); font-size: 16px; line-height: 1.75; }
  .hero-actions { display: flex; align-items: center; gap: 24px; }
  .text-link { font-size: 13px; font-weight: 700; }
  .hero-note { margin-top: 20px; color: var(--color-muted); font-size: 12px; }
  .preview-wrap { position: relative; display: grid; min-height: 650px; place-items: center; }
  .preview-glow { position: absolute; width: min(460px, 92%); aspect-ratio: 1; border-radius: 50%; background: var(--color-paper-raised); }
  .app-window { position: relative; width: min(470px, 94%); height: 610px; overflow: hidden; border: 1px solid var(--color-line); border-radius: 18px; background: var(--color-paper); box-shadow: 0 25px 70px color-mix(in srgb, var(--color-ink) 14%, transparent); }
  .window-bar { position: relative; z-index: 1; display: flex; height: 34px; align-items: center; justify-content: space-between; padding: 0 12px; border-bottom: 1px solid var(--color-line); background: var(--color-paper-raised); }
  .window-dots { display: flex; gap: 5px; }.window-dots i { width: 7px; height: 7px; border-radius: 50%; background: var(--color-line-strong); }.window-dots i:first-child { background: var(--color-ink-muted); }
  .window-address { position: absolute; left: 50%; color: var(--color-muted); font-size: 12px; font-weight: 600; transform: translateX(-50%); }.window-lock { color: var(--color-body-muted); font-size: 12px; }
  .app-window iframe { display: block; width: 100%; height: calc(100% - 34px); border: 0; background: var(--color-paper); }
  .floating-note { position: absolute; right: 0; bottom: 2px; display: flex; align-items: center; gap: 10px; padding: 12px 16px; border: 1px solid var(--color-line-soft); border-radius: 13px; background: var(--color-paper); box-shadow: 0 12px 30px color-mix(in srgb, var(--color-ink) 7%, transparent); }
  .check { display: grid; width: 25px; height: 25px; place-items: center; border-radius: 50%; background: var(--color-paper-raised); color: var(--color-ink-muted); font-size: 13px; }.floating-note b,.floating-note small { display: block; }.floating-note b { font-size: 12px; }.floating-note small { margin-top: 3px; color: var(--color-muted); font-size: 12px; }
  .trust-strip { display: flex; align-items: center; justify-content: space-between; gap: 20px; max-width: 1160px; margin: 0 auto; padding: 22px 0; border-top: 1px solid var(--color-line); border-bottom: 1px solid var(--color-line); color: var(--color-body); font-size: 12px; font-weight: 650; }
  .trust-strip p { margin: 0; color: var(--color-muted); font-size: 12px; font-weight: 500; }.trust-strip div { display: flex; align-items: center; gap: 9px; }.trust-strip div span { color: var(--color-ink-muted); font-size: 12px; }
  .features { display: grid; grid-template-columns: .8fr 1.2fr; gap: 70px; max-width: 1160px; margin: auto; padding: 110px 0 120px; }
  .section-heading .eyebrow { margin-bottom: 18px; }.section-heading h2,.closing-cta h2 { margin: 0; font-size: 41px; line-height: 1.1; letter-spacing: -2px; }
  .step-list { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--color-line); }.step-list li { display: grid; grid-template-columns: 42px 1fr; align-items: start; gap: 14px; padding: 23px 0; border-bottom: 1px solid var(--color-line); }.step-number { padding-top: 2px; color: var(--color-ink-muted); font-size: 15px; font-weight: 800; }.step-list p { margin: 0; color: var(--color-body); font-size: 16px; line-height: 1.55; font-weight: 600; }
  .role-features { padding-top: 20px; }
  .feature-list { border-top: 1px solid var(--color-line); }.feature-item { display: grid; grid-template-columns: 42px 1fr 20px; align-items: start; gap: 14px; padding: 23px 0; border-bottom: 1px solid var(--color-line); }.feature-number { padding-top: 3px; color: var(--color-ink-muted); font-size: 12px; font-weight: 800; }.feature-item h3 { margin: 0; font-size: 16px; }.feature-item p { max-width: 470px; margin: 8px 0 0; color: var(--color-muted); font-size: 13px; line-height: 1.65; }.feature-arrow { color: var(--color-muted); }
  .proof-section { max-width: 1160px; margin: 0 auto; padding: 20px 0 110px; }.proof-section .section-heading { margin-bottom: 30px; }.proof-section .section-heading h2 { margin: 0; font-size: 41px; line-height: 1.1; letter-spacing: -2px; }.proof-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }.proof-card { min-height: 150px; padding: 24px; border: 1px solid var(--color-line); border-radius: 16px; background: var(--color-paper); }.proof-card h3 { margin: 0 0 16px; font-size: 16px; }.proof-card p { margin: 0; color: var(--color-body-muted); font-size: 15px; line-height: 1.5; }
  .demo-section { display: flex; align-items: center; justify-content: space-between; gap: 24px; max-width: 1160px; margin: 0 auto 100px; padding: 34px 0; border-top: 1px solid var(--color-line); border-bottom: 1px solid var(--color-line); }.demo-section .eyebrow { margin-bottom: 12px; }.demo-section h2 { margin: 0; font-size: 30px; letter-spacing: -1px; }.demo-section p:not(.eyebrow) { margin: 8px 0 0; color: var(--color-body-muted); font-size: 15px; }
  .closing-cta { display: flex; align-items: center; justify-content: space-between; gap: 30px; max-width: 1160px; margin: 0 auto 80px; padding: 46px 52px; border-radius: 20px; background: var(--color-ink); color: var(--color-paper); }.closing-cta .eyebrow { color: var(--color-line-strong); }.closing-cta h2 { font-size: 32px; }.button-light { flex: 0 0 auto; background: var(--color-paper-muted); color: var(--color-ink); }.button-light:hover { background: var(--color-line-strong); }
  footer { display: flex; align-items: center; gap: 22px; max-width: 1160px; margin: auto; padding: 0 0 35px; }.footer .brand { font-size: 17px; }footer p { margin: 0; color: var(--color-muted); font-size: 12px; }footer > span { margin-left: auto; color: var(--color-muted); font-size: 12px; }
  @media (max-width: 900px) { .trust-strip,.features,.proof-section,.demo-section,.closing-cta,footer { margin-right: 30px; margin-left: 30px; }.features { gap: 38px; } }
  @media (max-width: 680px) { .topbar { height: 70px; padding: 0 20px; }.brand { font-size: 18px; }nav { gap: 14px; }nav a:first-child { display: none; }.button-small { min-height: 38px; padding: 0 12px; font-size: 12px; }.hero { grid-template-columns: 1fr; gap: 12px; min-height: auto; padding: 54px 22px 38px; }.hero-copy { max-width: 520px; }h1 { font-size: clamp(48px, 12.5vw, 64px); letter-spacing: -.5px; }.hero-description { margin: 20px 0; font-size: 14px; }.hero-actions { align-items: flex-start; flex-direction: column; gap: 17px; }.hero-note { margin-top: 15px; }.preview-wrap { min-height: 590px; }.app-window { width: min(440px, 96%); height: 560px; }.preview-glow { width: min(380px, 92%); }.floating-note { right: -2px; bottom: 0; }.trust-strip { align-items: flex-start; flex-direction: column; margin: 0 22px; padding: 20px 0; }.trust-strip p { margin-bottom: 3px; }.features { grid-template-columns: 1fr; gap: 30px; margin: 0 22px; padding: 74px 0; }.section-heading h2 { font-size: 36px; }.proof-section { margin: 0 22px; padding: 12px 0 74px; }.proof-section .section-heading h2 { font-size: 36px; }.proof-grid { grid-template-columns: 1fr; }.proof-card { min-height: 0; }.demo-section { align-items: flex-start; flex-direction: column; margin: 0 22px 74px; }.demo-section .button { width: 100%; }.closing-cta { align-items: flex-start; flex-direction: column; margin: 0 22px 56px; padding: 30px 24px; }.closing-cta h2 { font-size: 29px; }.closing-cta .button { width: 100%; }footer { flex-wrap: wrap; gap: 12px; margin: 0 22px; padding-bottom: 25px; }footer p { flex-basis: 100%; order: 3; }footer nav { flex-basis: 100%; order: 4; }footer > span { margin-left: 0; order: 5; } }
  @media (prefers-reduced-motion: reduce) { :global(html) { scroll-behavior: auto; }.button { transition: none; } }
</style>
