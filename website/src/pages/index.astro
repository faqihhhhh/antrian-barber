---
const appUrl = import.meta.env.PUBLIC_APP_URL || 'http://localhost:5173'
const siteUrl = import.meta.env.PUBLIC_SITE_URL || Astro.url.origin
const pageUrl = new URL(Astro.url.pathname, siteUrl).href
const socialImage = new URL('/icons/icon-512.png', siteUrl).href
const appScreenshots = [
  { src: '/screenshots/customer-outlet.png', title: 'Halaman outlet pelanggan' },
  { src: '/screenshots/customer-ticket.png', title: 'Tiket pelanggan' },
  { src: '/screenshots/admin-queue.png', title: 'Meja admin' },
  { src: '/screenshots/kapster-queue.png', title: 'Meja kapster' },
  { src: '/screenshots/owner-home.png', title: 'Beranda owner' },
  { src: '/screenshots/customer-login.png', title: 'Masuk ke Trimwait' },
]
const features = [
  {
    number: '01',
    title: 'Pelanggan pesan sendiri',
    description: 'Bagikan tautan outlet atau QR agar pelanggan bisa memilih tanggal, memesan antrian, dan membayar DP.',
  },
  {
    number: '02',
    title: 'Tim tahu siapa berikutnya',
    description: 'Admin mengelola antrian dan pembayaran DP. Kapster memanggil pelanggan serta memperbarui status layanan.',
  },
  {
    number: '03',
    title: 'Pemilik melihat usaha',
    description: 'Owner mengatur outlet dan staf, memantau statistik, serta melihat ulasan pelanggan.',
  },
]
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F5F3FB" />
    <meta name="description" content="Trimwait membantu barbershop dan salon mengelola antrian pelanggan secara online." />
    <link rel="icon" href="/icons/icon-512.png" type="image/png" />
    <meta property="og:title" content="Trimwait — Antrian salon lebih tertata" />
    <meta property="og:description" content="Trimwait membantu barbershop dan salon mengelola antrian pelanggan secara online." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>Trimwait — Antrian salon lebih tertata</title>
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href="#beranda" aria-label="Trimwait, ke beranda"><img src="/trimwait-logo.png" alt="" /></a>
      <nav aria-label="Navigasi utama">
        <a href="#cara-kerja">Cara kerja</a>
        <a class="nav-login" href={`${appUrl}/masuk`}>Masuk</a>
        <a class="button button-small" href={`${appUrl}/daftar`}>Buat akun</a>
      </nav>
    </header>

    <main id="beranda">
      <section class="hero">
        <div class="hero-copy">
          <p class="eyebrow"><span></span> UNTUK BARBERSHOP &amp; SALON</p>
          <h1>Antrian rapi.<br /><em>Pelanggan nyaman.</em></h1>
          <p class="hero-description">Bantu pelanggan memesan dari ponsel, dan bantu tim mengelola layanan tanpa kehilangan urutan.</p>
          <div class="hero-actions">
            <a class="button" href={`${appUrl}/daftar`}>Buat akun</a>
            <a class="text-link" href="#cara-kerja">Lihat cara kerja</a>
          </div>
          <p class="hero-note">Untuk pemilik usaha, admin, kapster, dan pelanggan.</p>
        </div>

        <div class="preview-wrap">
          <div class="preview-glow"></div>
          <div class="app-window">
            <div class="window-bar" aria-hidden="true">
              <span class="window-dots"><i></i><i></i><i></i></span>
              <span class="window-address">Trimwait · aplikasi</span>
              <span class="window-lock">●</span>
            </div>
            <div class="hero-carousel" data-hero-carousel role="region" aria-label="Pratinjau aplikasi Trimwait">
              <div class="hero-carousel-track" data-hero-track tabindex="0" aria-label="Geser untuk mengganti screenshot aplikasi">
                {appScreenshots.map((screenshot, index) => (
                  <figure class="hero-slide" role="group" aria-roledescription="slide" aria-label={`${index + 1} dari ${appScreenshots.length}`}>
                    <img src={screenshot.src} alt={screenshot.title} loading={index === 0 ? 'eager' : 'lazy'} />
                  </figure>
                ))}
              </div>
              <div class="hero-carousel-controls">
                <button class="hero-carousel-button" type="button" data-hero-previous aria-label="Screenshot sebelumnya" disabled>Sebelumnya</button>
                <span class="hero-carousel-count" data-hero-count aria-live="polite">1 / {appScreenshots.length}</span>
                <span class="hero-carousel-title" data-hero-title>{appScreenshots[0].title}</span>
                <button class="hero-carousel-button" type="button" data-hero-next aria-label="Screenshot berikutnya">Berikutnya</button>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="trust-strip" aria-label="Manfaat Trimwait">
        <p>Lebih teratur dari awal sampai selesai</p>
        <div><span>01</span> Pesan online</div><div><span>02</span> Pantau giliran</div><div><span>03</span> Kelola dari satu layar</div>
      </section>

      <section id="cara-kerja" class="features workflow">
        <div class="section-heading"><p class="eyebrow">LANGKAH PEMESANAN</p><h2>Dari scan sampai<br />dipanggil.</h2></div>
        <ol class="step-list">
          <li><span class="step-number" data-step-number>01</span><p>Pelanggan scan QR atau buka tautan outlet</p></li>
          <li><span class="step-number" data-step-number>02</span><p>Pelanggan pilih tanggal dan bayar DP lewat QRIS</p></li>
          <li><span class="step-number" data-step-number>03</span><p>Tim memanggil pelanggan sesuai urutan</p></li>
        </ol>
      </section>

      <section class="features role-features">
        <div class="section-heading"><p class="eyebrow">FITUR SESUAI PERAN</p><h2>Untuk pemilik,<br />admin, dan kapster.</h2></div>
        <div class="feature-list">
          {features.map((feature) => (
            <article class="feature-item">
              <span class="feature-number">{feature.number}</span>
              <div><h3>{feature.title}</h3><p>{feature.description}</p></div>
            </article>
          ))}
        </div>
      </section>

      <section class="pricing-section" aria-labelledby="pricing-title">
        <div class="section-heading"><p class="eyebrow">HARGA LANGGANAN</p><h2 id="pricing-title">Pilih masa berlangganan.</h2></div>
        <div class="pricing-grid" data-pricing-plans aria-live="polite" aria-busy="true">
          <p class="pricing-loading">Memuat harga terbaru…</p>
        </div>
        <div class="additional-pricing" aria-live="polite">
          <div><p class="eyebrow">BISNIS DENGAN BEBERAPA LOKASI</p><h3>Outlet ke-2 dan seterusnya</h3><p>Satu outlet sudah termasuk dalam paket bisnis. Setiap outlet tambahan ditagih terpisah.</p></div>
          <div class="additional-pricing-options" data-pricing-addons aria-busy="true">
            <p class="pricing-loading">Memuat harga outlet…</p>
          </div>
        </div>
      </section>

      <section class="demo-section" aria-labelledby="demo-title">
        <div><p class="eyebrow">LIHAT LANGSUNG</p><h2 id="demo-title">Minta demo</h2><p>Lihat alur Trimwait sebelum memilih.</p></div>
        <!-- TODO pemilik: isi email kontak untuk permintaan demo --><a class="button" href="mailto:[EMAIL: isi oleh pemilik]">Minta demo</a>
      </section>

      <section class="closing-cta">
        <div><p class="eyebrow">MULAI DARI OUTLET PERTAMAMU</p><h2>Beri waktu lebih banyak<br />untuk pelangganmu.</h2></div>
        <a class="button button-light" href={`${appUrl}/daftar`}>Buat akun</a>
      </section>
    </main>

    <footer><a class="brand" href="#beranda" aria-label="Trimwait, ke beranda"><img src="/trimwait-logo.png" alt="" /></a><p>Antrian lebih tertata, layanan lebih nyaman.</p><nav aria-label="Informasi hukum"><a href="/syarat">Syarat penggunaan</a><a href="/privasi">Privasi</a></nav><span>© {new Date().getFullYear()} Trimwait</span></footer>
<script>
  const carousel = document.querySelector<HTMLElement>('[data-hero-carousel]')
  const track = carousel?.querySelector<HTMLElement>('[data-hero-track]')
  const count = carousel?.querySelector<HTMLElement>('[data-hero-count]')
  const title = carousel?.querySelector<HTMLElement>('[data-hero-title]')
  const previous = carousel?.querySelector<HTMLButtonElement>('[data-hero-previous]')
  const next = carousel?.querySelector<HTMLButtonElement>('[data-hero-next]')
  const slides = track ? Array.from(track.querySelectorAll<HTMLElement>('.hero-slide')) : []

  if (track && count && title && previous && next && slides.length > 0) {
    let activeIndex = 0
    const updateControls = () => {
      activeIndex = Math.max(0, Math.min(slides.length - 1, Math.round(track.scrollLeft / track.clientWidth)))
      count.textContent = `${activeIndex + 1} / ${slides.length}`
      title.textContent = slides[activeIndex].querySelector('img')?.alt ?? ''
      previous.disabled = activeIndex === 0
      next.disabled = activeIndex === slides.length - 1
    }

    previous.addEventListener('click', () => track.scrollTo({ left: (activeIndex - 1) * track.clientWidth, behavior: 'smooth' }))
    next.addEventListener('click', () => track.scrollTo({ left: (activeIndex + 1) * track.clientWidth, behavior: 'smooth' }))
    track.addEventListener('scroll', () => window.requestAnimationFrame(updateControls), { passive: true })
    window.addEventListener('resize', updateControls)
    updateControls()
  }

  const planContainer = document.querySelector<HTMLElement>('[data-pricing-plans]')
  const addonContainer = document.querySelector<HTMLElement>('[data-pricing-addons]')
  const rupiah = new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 })

  async function refreshPricing() {
    if (!planContainer || !addonContainer) return
    try {
      const response = await fetch('/v1/plans/pricing', { headers: { Accept: 'application/json' } })
      if (!response.ok) throw new Error('Harga belum dapat dimuat.')
      const pricing = await response.json() as {
        plans: { code: string; name: string; price_rupiah: number; billing_interval: string }[]
        additional_outlet_monthly_price_rupiah: number
        additional_outlet_yearly_price_rupiah: number
      }
      planContainer.replaceChildren(...pricing.plans.map((plan) => {
        const card = document.createElement('article')
        card.className = 'pricing-card'
        const heading = document.createElement('h3')
        heading.textContent = `${plan.name} · ${plan.billing_interval === 'yearly' ? 'Tahunan' : 'Bulanan'}`
        const amount = document.createElement('p')
        amount.className = 'pricing-amount'
        amount.textContent = rupiah.format(plan.price_rupiah)
        const interval = document.createElement('span')
        interval.textContent = plan.billing_interval === 'yearly' ? 'per tahun' : 'per bulan'
        amount.append(' ', interval)
        card.append(heading, amount)
        return card
      }))
      const addonPrices = [
        { label: 'Bulanan', amount: pricing.additional_outlet_monthly_price_rupiah, interval: 'per bulan' },
        { label: 'Tahunan', amount: pricing.additional_outlet_yearly_price_rupiah, interval: 'per tahun' },
      ]
      addonContainer.replaceChildren(...addonPrices.map((price) => {
        const item = document.createElement('article')
        item.className = 'additional-pricing-card'
        const label = document.createElement('h4')
        label.textContent = price.label
        const amount = document.createElement('strong')
        amount.textContent = price.amount > 0 ? `${rupiah.format(price.amount)} ${price.interval}` : 'Belum tersedia'
        item.append(label, amount)
        return item
      }))
      planContainer.setAttribute('aria-busy', 'false')
      addonContainer.setAttribute('aria-busy', 'false')
    } catch {
      const unavailable = document.createElement('p')
      unavailable.className = 'pricing-loading'
      unavailable.textContent = 'Harga belum dapat dimuat. Coba beberapa saat lagi.'
      planContainer.replaceChildren(unavailable)
      addonContainer.replaceChildren(unavailable.cloneNode(true))
      planContainer.setAttribute('aria-busy', 'false')
      addonContainer.setAttribute('aria-busy', 'false')
    }
  }

  void refreshPricing()
  window.setInterval(refreshPricing, 30_000)
  window.addEventListener('focus', refreshPricing)
</script>
  </body>
</html>

<style>
  :global(:root) { --color-ink: #282544; --color-ink-hover: #39345F; --color-ink-muted: #5B5679; --color-ink-brand: #34305E; --color-paper: #F5F3FB; --color-paper-raised: #ECE9F7; --color-paper-muted: #DED9EF; --color-line: #E2DEEF; --color-line-soft: #F1EFF8; --color-line-strong: #C9C3DF; --color-muted: #6C687C; --color-body-muted: #55516A; --color-body: #3E3A50; --color-brand: #5148A8; --color-brand-ink: #3F378D; --color-accent: #6758C8; --color-accent-ink: #4E419F; --color-accent-soft: #EEEBFC; --color-accent-on-dark: #C9C2FB; }
  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-behavior: smooth; }
  :global(body) { margin: 0; background: var(--color-paper); color: var(--color-ink); font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
  :global(a) { color: inherit; text-decoration: none; }
  :global(:where(a, button, input, select, textarea, [tabindex]):focus-visible) { outline: 2px solid var(--color-brand-ink); outline-offset: 2px; }
  .topbar { height: 82px; max-width: 1240px; margin: auto; padding: 0 40px; display: flex; align-items: center; justify-content: space-between; }
  .brand { display: inline-flex; align-items: center; color: var(--color-ink-brand); }
  .brand img { display: block; width: 156px; height: 32px; object-fit: contain; }
  nav { display: flex; align-items: center; gap: 30px; font-size: 13px; font-weight: 600; }
  nav a:not(.button) { color: var(--color-body-muted); }
  .button { display: inline-flex; align-items: center; justify-content: center; gap: 16px; min-height: 52px; padding: 0 22px; border-radius: 12px; background: var(--color-ink); color: var(--color-paper); font-size: 14px; font-weight: 700; transition: transform .2s, background .2s; }
  .button:hover { transform: translateY(-2px); background: var(--color-ink-hover); }
  .button-small { min-height: 42px; padding: 0 16px; }
  .hero { display: grid; grid-template-columns: 1.02fr .98fr; align-items: center; gap: 40px; max-width: 1240px; min-height: 720px; margin: auto; padding: 64px 40px 74px; }
  .hero-copy { position: relative; z-index: 1; }
  .eyebrow { margin: 0 0 22px; color: var(--color-accent); font-size: 12px; font-weight: 800; letter-spacing: 1.7px; }
  .hero .eyebrow { display: flex; align-items: center; gap: 9px; }
  .hero .eyebrow span, .live-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--color-accent); }
  h1 { margin: 0; font-size: clamp(48px, 6vw, 76px); line-height: .99; letter-spacing: -1.5px; font-weight: 750; }
  h1 em { color: var(--color-accent); font-style: normal; }
  .hero-description { max-width: 465px; margin: 26px 0 28px; color: var(--color-body-muted); font-size: 16px; line-height: 1.75; }
  .hero-actions { display: flex; align-items: center; gap: 24px; }
  .text-link { font-size: 13px; font-weight: 700; }
  .hero-note { margin-top: 20px; color: var(--color-muted); font-size: 12px; }
  .preview-wrap { position: relative; display: grid; min-height: 650px; place-items: center; }
  .preview-glow { position: absolute; width: min(460px, 92%); aspect-ratio: 1; border-radius: 50%; background: var(--color-paper-raised); }
  .app-window { position: relative; width: min(470px, 94%); height: 610px; overflow: hidden; border: 1px solid var(--color-line); border-radius: 18px; background: var(--color-paper); box-shadow: 0 25px 70px color-mix(in srgb, var(--color-ink) 14%, transparent); }
  .window-bar { position: relative; z-index: 1; display: flex; height: 34px; align-items: center; justify-content: space-between; padding: 0 12px; border-bottom: 1px solid var(--color-line); background: var(--color-paper-raised); }
  .window-dots { display: flex; gap: 5px; }.window-dots i { width: 7px; height: 7px; border-radius: 50%; background: var(--color-line-strong); }.window-dots i:first-child { background: var(--color-ink-muted); }
  .window-address { position: absolute; left: 50%; color: var(--color-muted); font-size: 12px; font-weight: 600; transform: translateX(-50%); }.window-lock { color: var(--color-body-muted); font-size: 12px; }
  .hero-carousel { height: calc(100% - 34px); }.hero-carousel-track { display: flex; width: 100%; height: calc(100% - 48px); overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; scrollbar-width: none; scroll-behavior: smooth; }.hero-carousel-track::-webkit-scrollbar { display: none; }.hero-slide { display: grid; flex: 0 0 100%; height: 100%; margin: 0; place-items: center; scroll-snap-align: start; scroll-snap-stop: always; background: var(--color-paper); }.hero-slide img { display: block; width: 100%; height: 100%; object-fit: contain; object-position: center; }.hero-carousel-controls { display: flex; height: 48px; align-items: center; gap: 10px; padding: 0 12px; border-top: 1px solid var(--color-line); background: var(--color-paper); }.hero-carousel-button { display: inline-flex; min-height: 30px; flex: 0 0 auto; align-items: center; justify-content: center; padding: 0 10px; border: 1px solid var(--color-line-strong); border-radius: 8px; background: var(--color-paper); color: var(--color-ink); font-size: 11px; font-weight: 650; cursor: pointer; }.hero-carousel-button:disabled { opacity: .45; cursor: default; }.hero-carousel-count { min-width: 36px; color: var(--color-body-muted); font-size: 11px; font-weight: 700; text-align: center; }.hero-carousel-title { overflow: hidden; color: var(--color-body); font-size: 12px; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }
  .trust-strip { display: flex; align-items: center; justify-content: space-between; gap: 20px; max-width: 1160px; margin: 0 auto; padding: 22px 0; border-top: 1px solid var(--color-line); border-bottom: 1px solid var(--color-line); color: var(--color-body); font-size: 12px; font-weight: 650; }
  .trust-strip p { margin: 0; color: var(--color-muted); font-size: 12px; font-weight: 500; }.trust-strip div { display: flex; align-items: center; gap: 9px; }.trust-strip div span { color: var(--color-ink-muted); font-size: 12px; }
  .features { display: grid; grid-template-columns: .8fr 1.2fr; gap: 70px; max-width: 1160px; margin: auto; padding: 110px 0 120px; }
  .section-heading .eyebrow { margin-bottom: 18px; }.section-heading h2,.closing-cta h2 { margin: 0; font-size: 41px; line-height: 1.1; letter-spacing: -2px; }
  .step-list { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--color-line); }.step-list li { display: grid; grid-template-columns: 42px 1fr; align-items: start; gap: 14px; padding: 23px 0; border-bottom: 1px solid var(--color-line); }.step-number { padding-top: 2px; color: var(--color-ink-muted); font-size: 15px; font-weight: 800; }.step-list p { margin: 0; color: var(--color-body); font-size: 16px; line-height: 1.55; font-weight: 600; }
  .role-features { padding-top: 20px; }
  .feature-list { border-top: 1px solid var(--color-line); }.feature-item { display: grid; grid-template-columns: 42px 1fr; align-items: start; gap: 14px; padding: 23px 0; border-bottom: 1px solid var(--color-line); }.feature-number { padding-top: 3px; color: var(--color-accent); font-size: 12px; font-weight: 800; }.feature-item h3 { margin: 0; font-size: 16px; }.feature-item p { max-width: 470px; margin: 8px 0 0; color: var(--color-muted); font-size: 13px; line-height: 1.65; }
  .pricing-section { max-width: 1160px; margin: 0 auto; padding: 20px 0 110px; }.pricing-section .section-heading { margin-bottom: 30px; }.pricing-section .section-heading h2 { margin: 0; font-size: 41px; line-height: 1.1; letter-spacing: -2px; }.pricing-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; max-width: 760px; }.pricing-card { min-height: 166px; padding: 24px; border: 1px solid var(--color-line-strong); border-radius: 16px; background: linear-gradient(145deg, var(--color-paper), #fff 85%); }.pricing-card h3 { margin: 0 0 18px; font-size: 16px; }.pricing-amount { margin: 0; color: var(--color-accent-ink); font-size: clamp(32px, 5vw, 44px); font-weight: 850; line-height: 1.05; letter-spacing: -1.5px; }.pricing-amount span { display: block; margin-top: 8px; color: var(--color-body-muted); font-size: 14px; font-weight: 500; letter-spacing: 0; }.pricing-loading { margin: 0; color: var(--color-muted); font-size: 14px; }.additional-pricing { display: grid; grid-template-columns: .8fr 1.2fr; align-items: center; gap: 24px; max-width: 960px; margin-top: 20px; padding: 24px; border: 1px solid var(--color-line); border-radius: 16px; background: white; }.additional-pricing .eyebrow { margin-bottom: 10px; }.additional-pricing h3 { margin: 0; font-size: 19px; }.additional-pricing p:not(.eyebrow) { margin: 8px 0 0; color: var(--color-body-muted); font-size: 13px; line-height: 1.6; }.additional-pricing-options { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }.additional-pricing-card { display: flex; min-height: 96px; flex-direction: column; justify-content: space-between; gap: 10px; padding: 16px; border: 1px solid var(--color-line); border-radius: 12px; background: var(--color-accent-soft); }.additional-pricing-card h4 { margin: 0; color: var(--color-body-muted); font-size: 13px; font-weight: 600; }.additional-pricing-card strong { color: var(--color-accent-ink); font-size: clamp(18px, 2vw, 22px); font-weight: 800; line-height: 1.25; }
  .demo-section { display: flex; align-items: center; justify-content: space-between; gap: 24px; max-width: 1160px; margin: 0 auto 100px; padding: 34px 0; border-top: 1px solid var(--color-line); border-bottom: 1px solid var(--color-line); }.demo-section .eyebrow { margin-bottom: 12px; }.demo-section h2 { margin: 0; font-size: 30px; letter-spacing: -1px; }.demo-section p:not(.eyebrow) { margin: 8px 0 0; color: var(--color-body-muted); font-size: 15px; }
  .closing-cta { display: flex; align-items: center; justify-content: space-between; gap: 30px; max-width: 1160px; margin: 0 auto 80px; padding: 46px 52px; border-radius: 20px; background: var(--color-ink-brand); color: var(--color-paper); }.closing-cta .eyebrow { color: var(--color-accent-on-dark); }.closing-cta h2 { font-size: 32px; }.button-light { flex: 0 0 auto; background: var(--color-paper); color: var(--color-ink); }.button-light:hover { background: var(--color-paper-raised); }
