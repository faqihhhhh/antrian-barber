---
interface Props {
  title: string
  intro: string
}

const { title, intro } = Astro.props
const siteUrl = import.meta.env.PUBLIC_SITE_URL || import.meta.env.RENDER_EXTERNAL_URL || Astro.url.origin
const pageUrl = new URL(Astro.url.pathname, siteUrl).href
const socialImage = new URL('/icons/trimwait-share.png', siteUrl).href
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F5F3FB" />
    <meta name="description" content={intro} />
    <link rel="icon" href="/icons/icon.svg?v=2" type="image/svg+xml" />
    <link rel="icon" href="/icons/trimwait-share.png?v=2" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/icons/trimwait-share.png?v=2" />
    <meta property="og:title" content={`${title} — Trimwait`} />
    <meta property="og:description" content={intro} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title} — Trimwait</title>
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href="/" aria-label="Trimwait, ke beranda"><img src="/trimwait-logo.png" alt="" /></a>
      <nav aria-label="Navigasi utama"><a href="/">Beranda</a><a href="/syarat">Syarat penggunaan</a><a href="/privasi">Privasi</a></nav>
    </header>
    <main>
      <header class="page-heading"><p class="eyebrow">INFORMASI TRIMWAIT</p><h1>{title}</h1><p>{intro}</p><span class="updated">Draf untuk ditinjau sebelum peluncuran publik</span></header>
      <article class="document"><slot /></article>
      <p class="legal-reference">Dokumen ini perlu diperiksa dan dilengkapi oleh operator Trimwait sebelum digunakan sebagai ketentuan final.</p>
    </main>
    <footer><a class="brand" href="/" aria-label="Trimwait, ke beranda"><img src="/trimwait-logo.png" alt="" /></a><p>Antrian lebih tertata, layanan lebih nyaman.</p><span>© {new Date().getFullYear()} Trimwait</span></footer>
  </body>
</html>

<style>
  :global(:root) { --color-ink: #282544; --color-ink-hover: #39345F; --color-ink-muted: #5B5679; --color-ink-brand: #34305E; --color-paper: #F5F3FB; --color-paper-raised: #ECE9F7; --color-paper-muted: #DED9EF; --color-line: #E2DEEF; --color-line-soft: #F1EFF8; --color-line-strong: #C9C3DF; --color-muted: #6C687C; --color-body-muted: #55516A; --color-body: #3E3A50; --color-brand: #5148A8; --color-brand-ink: #3F378D; --color-accent: #6758C8; --color-accent-ink: #4E419F; --color-accent-soft: #EEEBFC; --color-accent-on-dark: #C9C2FB; }
  :global(*) { box-sizing: border-box; }
  :global(body) { margin: 0; background: var(--color-paper); color: var(--color-ink); font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
  :global(a) { color: inherit; }
  :global(:where(a, button, input, select, textarea, [tabindex]):focus-visible) { outline: 2px solid var(--color-brand-ink); outline-offset: 2px; }
  .topbar { height: 78px; max-width: 1120px; margin: auto; padding: 0 30px; display: flex; align-items: center; justify-content: space-between; }
  .brand { display: inline-flex; align-items: center; gap: 10px; font-size: 19px; font-weight: 800; letter-spacing: -.7px; text-decoration: none; }
  .brand { color: var(--color-ink-brand); }.brand img { display: block; width: 156px; height: 32px; object-fit: contain; }
  nav { display: flex; gap: 22px; font-size: 12px; font-weight: 650; }nav a { color: var(--color-body-muted); text-decoration: none; }
  main { max-width: 860px; min-height: calc(100vh - 160px); margin: 0 auto; padding: 52px 30px 90px; }
  .page-heading { padding-bottom: 28px; border-bottom: 1px solid var(--color-line); }.eyebrow { margin: 0 0 15px; color: var(--color-muted); font-size: 12px; font-weight: 800; letter-spacing: 1.7px; }
  h1 { margin: 0; font-size: clamp(36px, 7vw, 54px); line-height: 1.05; letter-spacing: -2.5px; }.page-heading > p:not(.eyebrow) { max-width: 640px; margin: 16px 0; color: var(--color-body-muted); font-size: 15px; line-height: 1.7; }.updated { display: inline-block; padding: 7px 10px; border-radius: 8px; background: var(--color-paper-raised); color: var(--color-body); font-size: 12px; font-weight: 700; }
  .document { padding-top: 8px; }.document h2 { margin: 30px 0 10px; font-size: 19px; letter-spacing: -.3px; }.document h3 { margin: 22px 0 8px; font-size: 15px; }.document p,.document li { color: var(--color-body); font-size: 14px; line-height: 1.75; }.document ul,.document ol { padding-left: 22px; }.document li + li { margin-top: 7px; }.document a { color: var(--color-ink-muted); text-decoration: underline; text-underline-offset: 3px; }.document .contact-box { margin-top: 14px; padding: 16px; border: 1px solid var(--color-line-strong); border-radius: 12px; background: var(--color-paper-raised); color: var(--color-body); }
  .legal-reference { margin-top: 35px; padding-top: 18px; border-top: 1px solid var(--color-line); color: var(--color-muted); font-size: 12px; line-height: 1.6; }
  footer { display: flex; align-items: center; gap: 20px; max-width: 800px; margin: auto; padding: 18px 30px 30px; border-top: 1px solid var(--color-line); }footer p,footer > span { margin: 0; color: var(--color-muted); font-size: 12px; }footer > span { margin-left: auto; }
  @media (max-width: 600px) { .topbar { height: 70px; padding: 0 20px; }.topbar nav { gap: 12px; font-size: 12px; }.topbar nav a:first-child { display: none; }main { padding: 38px 20px 64px; }.document h2 { margin-top: 25px; }.document p,.document li { font-size: 13px; }footer { flex-wrap: wrap; gap: 10px 16px; padding: 18px 20px 26px; }footer p { flex-basis: 100%; order: 3; }footer > span { margin-left: 0; } }
</style>
